[run]
omit =
    agentguard/cli.py
    agentguard/coordination.py
    agentguard/main.py
    agentguard/models.py
    agentguard/policy.py
    agentguard/shared_control.py
    agentguard/omniguard_client.py
    agentguard/vault_http.py
    agentguard/postgres.py

[report]
exclude_lines =
    pragma: no cover
